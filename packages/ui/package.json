{
  "name": "@education/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "testPathIgnorePatterns": ["/node_modules/"]
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@education/design": "0.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@education/eslint-config": "0.0.0",
    "@education/typescript-config": "0.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.2",
    "eslint": "^9.39.4",
    "expo-modules-core": "55.0.25",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.13",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "^15.15.4",
    "react-test-renderer": "19.2.0",
    "typescript": "5.9.2"
  }
}
