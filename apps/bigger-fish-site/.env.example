# Canonical origin. Production falls back to https://biggerfish.app; previews use VERCEL_URL.
NEXT_PUBLIC_SITE_ORIGIN=

# Once Bigger Fish is on the App Store: its product page and numeric app ID (from App Store Connect).
# The URL turns the "Coming soon" note into Apple's badge; the ID adds Safari's Smart App Banner.
NEXT_PUBLIC_BIGGER_FISH_APP_STORE_URL=
NEXT_PUBLIC_BIGGER_FISH_APP_STORE_ID=
# Set to true while the App Store page takes pre-orders, to show the pre-order badge.
NEXT_PUBLIC_BIGGER_FISH_PREORDER=

# A public TestFlight link, to invite players into the beta before launch. Leave empty to hide it.
NEXT_PUBLIC_BIGGER_FISH_TESTFLIGHT_URL=

# Where support and press email goes.
NEXT_PUBLIC_BIGGER_FISH_CONTACT_EMAIL=
